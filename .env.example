# A2LM Gateway — Environment Configuration
# Copy to .env and fill in your values

# The key YOU use to call the gateway
GATEWAY_API_KEY=your-personal-gateway-key

# Provider API Keys — add at least one
# Groq        → https://console.groq.com
GROQ_API_KEY=

# Cerebras    → https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Google AI   → https://aistudio.google.com
GOOGLE_AI_STUDIO_API_KEY=

# Mistral     → https://console.mistral.ai
MISTRAL_API_KEY=

# OpenRouter  → https://openrouter.ai
OPENROUTER_API_KEY=

# Cohere      → https://dashboard.cohere.com
COHERE_API_KEY=

# NVIDIA NIM  → https://build.nvidia.com (phone verification required)
NVIDIA_API_KEY=

# Cloudflare Workers AI → https://dash.cloudflare.com
# Account ID: right sidebar of Workers & Pages dashboard
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
